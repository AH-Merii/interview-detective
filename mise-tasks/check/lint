#!/usr/bin/env bash
#MISE description="Lint and format-check the Python (ruff) and the shell scripts (shellcheck)"
#MISE tools={ruff="0.17.0", shellcheck="0.11.0"}
# Rules and line length come from ruff.toml.
set -euo pipefail

rc=0
ruff check --no-cache . || rc=1
ruff format --check --no-cache . || rc=1
mapfile -t scripts < <(grep -rlE '^#!/usr/bin/env bash' tools setup mise-tasks .githooks)
shellcheck "${scripts[@]}" || rc=1
exit "$rc"
